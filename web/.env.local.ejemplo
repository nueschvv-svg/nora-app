# Copiá este archivo como ".env.local" (en esta misma carpeta) y pegá tus valores.
#
# ".env.local" está en el .gitignore: no se sube al repositorio ni sale de tu compu.
# Este archivo de ejemplo sí se sube, por eso NO pongas valores reales acá.
#
# Dónde sacar cada uno: Supabase → tu proyecto → Settings → API

# La dirección de tu proyecto. Es pública, no es un secreto.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave "anon" / "publishable". Viaja al navegador a propósito: está pensada
# para eso. Lo que la contiene son las políticas de db/02_permisos.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=pegá-acá-la-clave-anon

# ⚠️ La clave "service_role" NO va en este archivo.
# Saltea todos los permisos: con ella se lee y se borra cualquier dato de
# cualquier usuario. Nunca debe llegar al navegador. Cuando construyamos el
# panel de operaciones la vamos a configurar directamente en Vercel, como
# variable de entorno del servidor, sin que pase por el código.

# ⚠️ SECRETO. Gasta plata de tu cuenta de Anthropic.
# Se saca en console.anthropic.com → API Keys.
# Sólo se usa en el servidor: nunca lleva el prefijo NEXT_PUBLIC_,
# porque ese prefijo es lo que hace que una variable viaje al navegador.
ANTHROPIC_API_KEY=

# ---------- Enrutamiento de pedidos (ver lib/enrutamiento/) ----------
#
# Cuál usar hoy. "telegram" es el default si no se pone nada.
# El día que haya masa crítica de técnicos, se cambia a "matching"
# (cuando exista esa estrategia) sin tocar ningún otro archivo.
ESTRATEGIA_ENRUTAMIENTO=telegram

# ⚠️ SECRETO. Con este token cualquiera puede mandar mensajes como el bot.
# Cómo conseguirlo:
#   1. Hablale a @BotFather en Telegram, mandale /newbot y seguí los pasos.
#   2. Agregá el bot resultante al grupo/canal de Enjinia.
TELEGRAM_BOT_TOKEN=

# El chat_id del grupo/canal de Enjinia (un número, negativo si es grupo).
# Cómo conseguirlo: mandá cualquier mensaje en ese grupo mencionando al bot,
# y abrí https://api.telegram.org/bot<TOKEN>/getUpdates — ahí aparece.
TELEGRAM_CHAT_ID=
